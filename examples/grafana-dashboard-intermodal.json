            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "cps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*dropped.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
