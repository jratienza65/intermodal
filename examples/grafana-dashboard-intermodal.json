{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "intermodal's own health and headroom: Railway API budget, poll health, log throughput and drops.",
  "editable": true,
  "graphTooltip": 2,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Railway API requests per hour. Compare to your plan budget: Free 100 / Hobby 1,000 / Pro 10,000. Railway does not return rate-limit headers, so this counted rate is the reliable headroom signal.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 800 },
            { "color": "red", "value": 8000 }
          ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 20,
      "options": {
        "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value"
      },
      "pluginVersion": "10.4.0",
      "title": "Railway API req/hour",
      "type": "stat",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(railway_api_requests_total[10m])) * 3600", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 21,
      "options": {
        "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value"
      },
      "pluginVersion": "10.4.0",
      "title": "Targets discovered",
      "type": "stat",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(intermodal_targets_discovered)", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 22,
      "options": {
        "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value"
      },
      "pluginVersion": "10.4.0",
      "title": "Active log subscriptions",
      "type": "stat",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(intermodal_log_subscriptions_active)", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Logs dropped in the last 5m due to a full sink queue. Should be 0 — anything above means a sink can't keep up.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "decimals": 0, "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 23,
      "options": {
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value"
      },
      "pluginVersion": "10.4.0",
      "title": "Logs dropped (5m)",
      "type": "stat",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(increase(intermodal_logs_dropped_total[5m]))", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Railway API request rate by response code. Non-200 (429/error) means throttling or failures.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 24,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Railway API request rate (by code)",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (code) (rate(railway_api_requests_total[$__rate_interval]))",
          "legendFormat": "{{code}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Time for a full metrics poll cycle (p90). Must stay well under INTERMODAL_POLL_INTERVAL, or polls back up.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 25,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Metrics poll duration (p90)",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(intermodal_metrics_poll_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p90", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Log pipeline throughput: received from Railway vs forwarded per sink vs dropped per sink.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } },
          "unit": "cps"
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*dropped.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 26,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Log throughput (received / forwarded / dropped)",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(intermodal_logs_received_total[$__rate_interval]))", "legendFormat": "received", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (sink) (rate(intermodal_logs_forwarded_total[$__rate_interval]))", "legendFormat": "forwarded {{sink}}", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (sink) (rate(intermodal_logs_dropped_total[$__rate_interval]))", "legendFormat": "dropped {{sink}}", "refId": "C" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Sink write errors and Railway subscription reconnects — both should sit near zero.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } },
          "unit": "cps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 27,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Sink errors & subscription reconnects",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (sink) (rate(intermodal_log_sink_errors_total[$__rate_interval]))", "legendFormat": "sink errors {{sink}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(intermodal_log_subscription_reconnects_total[$__rate_interval]))", "legendFormat": "reconnects", "refId": "B" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["railway", "intermodal", "self"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "intermodal (self / headroom)",
  "uid": "intermodal-self",
  "version": 1,
  "weekStart": ""
}
