        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Railway services (intermodal)",
  "uid": "intermodal-railway",
  "version": 2,
  "weekStart": ""
