# intermodal configuration — copy to .env and fill in.
# Every knob is optional except the Railway token. Defaults shown in (parens).
# On Railway, set these as service variables instead of shipping a .env file.

# =============================================================================
# Railway auth (REQUIRED — provide exactly ONE of account OR project token)
# =============================================================================
# Account/workspace token (Authorization: Bearer). Enumerates ALL projects the
# token can see. Either RAILWAY_API_TOKEN or INTERMODAL_ACCOUNT_TOKEN.
RAILWAY_API_TOKEN=your-account-or-workspace-token
# INTERMODAL_ACCOUNT_TOKEN=your-account-or-workspace-token

# Project token (Project-Access-Token header). Scoped to a single environment.
# Any of the three names below works. Setting BOTH an account and a project
# token is a hard error.
# RAILWAY_PROJECT_TOKEN=your-project-token
# RAILWAY_TOKEN=your-project-token
# INTERMODAL_PROJECT_TOKEN=your-project-token

# Optional: scope account-token enumeration to a single workspace.
# INTERMODAL_WORKSPACE_ID=

# =============================================================================
# Railway client tuning
# =============================================================================
# INTERMODAL_RAILWAY_RPS=5
# INTERMODAL_RAILWAY_BURST=5
# INTERMODAL_RAILWAY_MAX_RETRIES=4
# Comma-separated endpoint overrides (defaults are Railway's public API).
# INTERMODAL_HTTP_ENDPOINTS=
# INTERMODAL_WS_ENDPOINTS=

# =============================================================================
# Discovery / target selection
# =============================================================================
# INTERMODAL_DISCOVERY_TTL=5m
# Comma-separated allowlists — accept IDs OR names (case-insensitive; empty =
# everything the token can see). Names are the readable ones from `doctor`.
# INTERMODAL_PROJECTS=
# INTERMODAL_ENVIRONMENTS=
# INTERMODAL_SERVICES=

# =============================================================================
# HTTP server (/metrics, /healthz, /readyz)
# =============================================================================
# On Railway, PORT is injected and the server binds 0.0.0.0:$PORT.
# Set INTERMODAL_HTTP_ADDR to override; else PORT; else 0.0.0.0:8080.
# INTERMODAL_HTTP_ADDR=0.0.0.0:8080
# Optional: require "Authorization: Bearer <token>" on /metrics (health stays open).
# INTERMODAL_METRICS_AUTH_TOKEN=

# =============================================================================
# Metrics exporter
# =============================================================================
# INTERMODAL_METRICS_ENABLED=true
# Comma-separated: "prometheus" (pull) and/or "otlp" (push).
# INTERMODAL_METRICS_EXPORTERS=prometheus
# INTERMODAL_POLL_INTERVAL=60s
# INTERMODAL_SAMPLE_RATE_SECONDS=60
# INTERMODAL_METRICS_WINDOW=10m
# intermodal's own metrics (intermodal_*, railway_api_*). INTERMODAL_SELF_METRICS
# is the master default (true) for both scrape and export; override each
# independently:
# INTERMODAL_SELF_METRICS=true
# INTERMODAL_SELF_METRICS_SCRAPE=true   # expose on /metrics
# INTERMODAL_SELF_METRICS_EXPORT=true   # push via OTLP (when otlp exporter on)

# =============================================================================
# Log drain
# =============================================================================
# INTERMODAL_LOGS_ENABLED=true
# Comma-separated sinks: "stdout", "loki", "otlp".
# INTERMODAL_SINKS=stdout
# Railway deploy-log filter DSL, e.g. "@level:error" or "@service:Zitadel".
# The @service: filter accepts a service NAME (Railway resolves it) and filters
# server-side, so it's the efficient way to scope deploy logs to one service.
# INTERMODAL_LOG_FILTER=
# INTERMODAL_LOG_BACKFILL=0
# INTERMODAL_LOG_QUEUE_SIZE=10000
# INTERMODAL_LOG_BATCH_SIZE=500
# INTERMODAL_LOG_BATCH_TIMEOUT=2s
# Two log streams (both under LOGS_ENABLED):
#   deploy = stdout/stderr (environmentLogs); http = edge/router request logs
#   (httpLogs, only for services with a public domain — great for correlation).
# INTERMODAL_DEPLOY_LOGS=true
# INTERMODAL_HTTP_LOGS=false
# HTTP-log filter DSL, e.g. "@httpStatus:>=500" or "@path:/api".
# INTERMODAL_HTTP_LOG_FILTER=
# Scope HTTP logs to specific services (IDs or names), independent of
# INTERMODAL_SERVICES so it doesn't affect metrics/deploy logs. Empty = all
# services with a domain.
# INTERMODAL_HTTP_LOG_SERVICES=
# Build logs: each deployment's build output (finite; fetched once per deploy,
# including the current one at startup). Scope independently.
# INTERMODAL_BUILD_LOGS=false
# Scope build logs to specific services (IDs or names). Empty = all.
# INTERMODAL_BUILD_LOG_SERVICES=

# =============================================================================
# Loki sink (required only if "loki" is in INTERMODAL_SINKS)
# =============================================================================
# Base URL; /loki/api/v1/push is appended automatically.
# INTERMODAL_LOKI_URL=http://loki.railway.internal:3100
# INTERMODAL_LOKI_TENANT_ID=my-tenant
# INTERMODAL_LOKI_LABELS=env=prod,app=intermodal

# =============================================================================
# OTLP (shared by the otlp log sink and the otlp metric exporter)
# =============================================================================
# Host:port or full http(s) URL. OTEL_EXPORTER_OTLP_ENDPOINT is also honored.
# INTERMODAL_OTLP_ENDPOINT=otel-collector.railway.internal:4318
# Set true for plain-http internal collectors.
# INTERMODAL_OTLP_INSECURE=false
# INTERMODAL_OTLP_HEADERS=x-api-key=abc123

# =============================================================================
# General
# =============================================================================
# INTERMODAL_LOG_LEVEL=info
# INTERMODAL_SERVICE_NAME=intermodal

# Instance identity. intermodal's own metrics describe the instance, not a
# Railway service, so nothing in their labels tells two instances apart. When
# several intermodal instances push over OTLP into one backend, they must each
# get a distinct service.instance.id or they all write the same series.
# Railway injects RAILWAY_SERVICE_ID (and the project/environment/service names
# used for grouping), so on Railway this needs no configuration. Set it by hand
# for more than one replica of one service, or when running off Railway with
# non-unique hostnames.
# INTERMODAL_INSTANCE_ID=${{RAILWAY_REPLICA_ID}}
# Extra OTLP resource attributes on the self-metrics; overrides the defaults.
# OTEL_RESOURCE_ATTRIBUTES is honored too.
# INTERMODAL_RESOURCE_ATTRIBUTES=deployment.tier=edge,team=platform

# -----------------------------------------------------------------------------
# Example: account token + Loki + OTLP push (uncomment and adapt)
# -----------------------------------------------------------------------------
# RAILWAY_API_TOKEN=rw_live_xxxxxxxxxxxxxxxxxxxxxxxx
# INTERMODAL_METRICS_EXPORTERS=prometheus,otlp
# INTERMODAL_SINKS=stdout,loki,otlp
# INTERMODAL_LOKI_URL=http://loki.railway.internal:3100
# INTERMODAL_LOKI_TENANT_ID=jratienza65
# INTERMODAL_LOKI_LABELS=env=prod,app=intermodal
# INTERMODAL_OTLP_ENDPOINT=otel-collector.railway.internal:4318
# INTERMODAL_OTLP_INSECURE=true
# INTERMODAL_LOG_FILTER=@level:error
